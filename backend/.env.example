# Server Configuration
PORT=3000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/grandeur?schema=public"

# Authentication Secrets (minimum 8 characters)
JWT_SECRET="super-secret-jwt-key-min-8-chars"
JWT_REFRESH_SECRET="super-secret-jwt-refresh-key-min-8-chars"

# Frontend URLs for CORS
FRONTEND_URL="http://localhost:5173"
ADMIN_FRONTEND_URL="http://localhost:3001"

# Razorpay Payment Gateway (Razorpay only - no Stripe)
RAZORPAY_KEY_ID="rzp_test_sampleKeyId"
RAZORPAY_KEY_SECRET="sampleKeySecret"
RAZORPAY_WEBHOOK_SECRET="sampleWebhookSecret"

# Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME="sample_cloud_name"
CLOUDINARY_API_KEY="123456789012345"
CLOUDINARY_API_SECRET="sample_cloudinary_secret"

# Resend Transactional Email (Email only - no SMS, no fake provider)
RESEND_API_KEY="re_sample_api_key"
RESEND_FROM_EMAIL="orders@yourdomain.com"
RESEND_ADMIN_EMAIL="admin@yourdomain.com"

# Redis Cache
REDIS_HOST="localhost"
REDIS_PORT=6379
# REDIS_PASSWORD=

# Logging & Monitoring
LOG_LEVEL="info"
LOG_REQUEST_BODY="false"
LOG_REQUEST_BODY_MAX_BYTES=4096

# Cache Invalidation & Health
CACHE_NAMESPACE="ecommerce"
CACHE_VERSION="v1"
HEALTH_CHECK_TIMEOUT_MS=2000
